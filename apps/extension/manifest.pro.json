{
  "manifest_version": 3,
  "name": "PromptIQ Pro",
  "version": "0.0.1",
  "description": "Score, fix, and adapt your AI prompts across Claude, ChatGPT, and Gemini.",
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "host_permissions": [
    "https://claude.ai/",
    "https://claude.ai/chat/*",
    "https://claude.ai/new",
    "https://claude.ai/project/*",
    "https://chatgpt.com/",
    "https://chatgpt.com/c/*",
    "https://chat.openai.com/",
    "https://chat.openai.com/c/*",
    "https://gemini.google.com/app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/",
        "https://claude.ai/chat/*",
        "https://claude.ai/new",
        "https://claude.ai/project/*",
        "https://chatgpt.com/",
        "https://chatgpt.com/c/*",
        "https://chat.openai.com/",
        "https://chat.openai.com/c/*",
        "https://gemini.google.com/app/*"
      ],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "PromptIQ Pro"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
